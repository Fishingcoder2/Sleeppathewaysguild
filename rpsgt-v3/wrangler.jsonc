{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Deployment marker: interaction-based printed study recommendations, 2026-08-07.
  "name": "rpsgt-v3-learning-center",
  "compatibility_date": "2026-04-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules",\n      "ui-next",\n      "workers",\n      "scripts",\n      "docs",\n      "audits",
      "tests",
      "test-results",
      "playwright-report",
      "README.md",
      "browser-regression-matrix.md",
      "package.json",
      "package-lock.json",
      "playwright.config.js",
      "wrangler.jsonc",\n      "wrangler.case-review-release.jsonc",
      ".gitignore"
    ]
  }
}

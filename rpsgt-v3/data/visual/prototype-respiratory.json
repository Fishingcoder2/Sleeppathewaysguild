  "questions": [
    {"id":"resp-normal-choice","studyId":"resp-normal-001","type":"choice","taskCode":"D3B","prompt":"Which overall respiratory pattern is this original schematic designed to represent?","options":["Normal breathing","Obstructive apnea pattern","Central apnea pattern","Mixed apnea pattern","Hypopnea / flow-limited pattern","Paradoxical breathing","Nasal pressure signal artifact"],"answer":"Normal breathing","rationale":"Airflow, thoracic effort, abdominal effort, RIP sum, gas-exchange trends, and neighboring signals remain coordinated without a deliberately inserted respiratory event."},
    {"id":"resp-obstructive-choice","studyId":"resp-obstructive-001","type":"choice","taskCode":"D3B","prompt":"Which overall respiratory pattern is this original schematic designed to represent?","options":["Normal breathing","Obstructive apnea pattern","Central apnea pattern","Mixed apnea pattern","Hypopnea / flow-limited pattern","Paradoxical breathing","Nasal pressure signal artifact"],"answer":"Obstructive apnea pattern","rationale":"The teaching pattern shows marked airflow loss while respiratory effort persists and increases; thoracoabdominal desynchrony is added as supporting obstructive context. Clinical scoring still requires current official criteria."},
    {"id":"resp-obstructive-point","studyId":"resp-obstructive-001","type":"point-click","taskCode":"D3B","prompt":"Click within the marked-airflow-loss teaching interval in Nasal Pressure.","target":{"channel":"Nasal Pressure","start":8.0,"end":17.0},"toleranceSeconds":0.2,"fallbackPoints":[{"label":"Nasal Pressure near 4 s","channel":"Nasal Pressure","time":4.0},{"label":"Nasal Pressure near 12 s","channel":"Nasal Pressure","time":12.0},{"label":"Nasal Pressure near 21 s","channel":"Nasal Pressure","time":21.0}],"rationale":"The app-authored airflow-loss interval occupies the middle of the segment while effort channels continue."},
    {"id":"resp-obstructive-delay","studyId":"resp-obstructive-001","type":"choice","taskCode":"D3B","prompt":"Which displayed signal is intentionally delayed after the airflow/effort event in this teaching case?","options":["SpO2","Thorax RIP","Abdomen RIP","Thermal Airflow"],"answer":"SpO2","rationale":"The schematic oxygen-saturation decline begins after the respiratory event rather than at the exact instant airflow falls."},
    {"id":"resp-central-choice","studyId":"resp-central-001","type":"choice","taskCode":"D3B","prompt":"Which overall respiratory pattern is this original schematic designed to represent?","options":["Normal breathing","Obstructive apnea pattern","Central apnea pattern","Mixed apnea pattern","Hypopnea / flow-limited pattern","Paradoxical breathing","Nasal pressure signal artifact"],"answer":"Central apnea pattern","rationale":"Airflow and inspiratory effort are both deliberately suppressed during the same interval in this schematic central-pattern example."},
    {"id":"resp-central-point","studyId":"resp-central-001","type":"point-click","taskCode":"D3B","prompt":"Click within the absent-effort teaching interval in Thorax RIP.","target":{"channel":"Thorax RIP","start":8.5,"end":17.0},"toleranceSeconds":0.2,"fallbackPoints":[{"label":"Thorax RIP near 4 s","channel":"Thorax RIP","time":4.0},{"label":"Thorax RIP near 12 s","channel":"Thorax RIP","time":12.0},{"label":"Thorax RIP near 22 s","channel":"Thorax RIP","time":22.0}],"rationale":"Thoracic and abdominal effort are intentionally absent with airflow during the central-pattern interval."},
    {"id":"resp-mixed-choice","studyId":"resp-mixed-001","type":"choice","taskCode":"D3B","prompt":"Which overall respiratory pattern is this original schematic designed to represent?","options":["Normal breathing","Obstructive apnea pattern","Central apnea pattern","Mixed apnea pattern","Hypopnea / flow-limited pattern","Paradoxical breathing","Nasal pressure signal artifact"],"answer":"Mixed apnea pattern","rationale":"The event begins with absent airflow and absent effort, then effort resumes while airflow remains markedly suppressed before recovery."},
    {"id":"resp-mixed-point","studyId":"resp-mixed-001","type":"point-click","taskCode":"D3B","prompt":"Click after inspiratory effort has resumed in Thorax RIP while airflow is still suppressed.","target":{"channel":"Thorax RIP","start":13.0,"end":18.0},"toleranceSeconds":0.2,"fallbackPoints":[{"label":"Thorax RIP near 9 s","channel":"Thorax RIP","time":9.0},{"label":"Thorax RIP near 15 s","channel":"Thorax RIP","time":15.0},{"label":"Thorax RIP near 23 s","channel":"Thorax RIP","time":23.0}],"rationale":"The app-authored mixed pattern resumes effort in the latter portion of the event while airflow remains suppressed."},
    {"id":"resp-flow-choice","studyId":"resp-flow-limited-001","type":"choice","taskCode":"D3B","prompt":"Which overall respiratory pattern is this original schematic designed to represent?","options":["Normal breathing","Obstructive apnea pattern","Central apnea pattern","Mixed apnea pattern","Hypopnea / flow-limited pattern","Paradoxical breathing","Nasal pressure signal artifact"],"answer":"Hypopnea / flow-limited pattern","rationale":"The schematic emphasizes reduced and flattened nasal-pressure excursions with continuing effort and supporting snore/oxygen context. It is morphology practice, not a claim that current scoring thresholds are met."},
    {"id":"resp-flow-interval","studyId":"resp-flow-limited-001","type":"interval-mark","taskCode":"D3B","prompt":"Drag across the reduced / flattened Nasal Pressure teaching interval.","target":{"channel":"Nasal Pressure","start":8.0,"end":20.0},"toleranceSeconds":0.8,"fallbackIntervals":[{"label":"Nasal Pressure 2–6 s","channel":"Nasal Pressure","start":2.0,"end":6.0},{"label":"Nasal Pressure 8–20 s","channel":"Nasal Pressure","start":8.0,"end":20.0},{"label":"Nasal Pressure 22–28 s","channel":"Nasal Pressure","start":22.0,"end":28.0}],"rationale":"The app-authored reduced-airflow morphology spans approximately 8–20 seconds."},
    {"id":"resp-paradox-choice","studyId":"resp-paradox-001","type":"choice","taskCode":"D2A","prompt":"Which overall respiratory pattern is this original schematic designed to represent?","options":["Normal breathing","Obstructive apnea pattern","Central apnea pattern","Mixed apnea pattern","Hypopnea / flow-limited pattern","Paradoxical breathing","Nasal pressure signal artifact"],"answer":"Paradoxical breathing","rationale":"Thoracic and abdominal effort become intentionally out of phase while the RIP sum becomes markedly diminished."},
    {"id":"resp-paradox-point","studyId":"resp-paradox-001","type":"point-click","taskCode":"D2A","prompt":"Click within the period where Abdomen RIP is intentionally out of phase with Thorax RIP.","target":{"channel":"Abdomen RIP","start":9.0,"end":17.0},"toleranceSeconds":0.2,"fallbackPoints":[{"label":"Abdomen RIP near 4 s","channel":"Abdomen RIP","time":4.0},{"label":"Abdomen RIP near 13 s","channel":"Abdomen RIP","time":13.0},{"label":"Abdomen RIP near 23 s","channel":"Abdomen RIP","time":23.0}],"rationale":"The app-authored paradox interval occupies the middle of the segment and is accompanied by a diminished RIP sum."},
    {"id":"resp-artifact-choice","studyId":"resp-artifact-001","type":"choice","taskCode":"D2B","prompt":"Which overall respiratory pattern is this original schematic designed to represent?","options":["Normal breathing","Obstructive apnea pattern","Central apnea pattern","Mixed apnea pattern","Hypopnea / flow-limited pattern","Paradoxical breathing","Nasal pressure signal artifact"],"answer":"Nasal pressure signal artifact","rationale":"Only the nasal-pressure channel is deliberately lost while thermal airflow, respiratory effort, gas-exchange trends, and neighboring signals remain intact."},
    {"id":"resp-artifact-point","studyId":"resp-artifact-001","type":"point-click","taskCode":"D2B","prompt":"Click within the isolated Nasal Pressure signal-loss interval.","target":{"channel":"Nasal Pressure","start":9.5,"end":17.5},"toleranceSeconds":0.2,"fallbackPoints":[{"label":"Nasal Pressure near 4 s","channel":"Nasal Pressure","time":4.0},{"label":"Nasal Pressure near 13 s","channel":"Nasal Pressure","time":13.0},{"label":"Thermal Airflow near 13 s","channel":"Thermal Airflow","time":13.0}],"rationale":"The teaching artifact is isolated to nasal pressure; corroborating channels continue normal respiratory activity."}
  ]

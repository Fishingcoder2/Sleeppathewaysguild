        {"label":"Thermal Airflow","type":"airflow","profile":"thermal","amplitude":0.76,"frequency":0.24,"phase":0.08,"features":[{"type":"airflow-suppress","start":7.5,"end":17.5,"depth":0.98}]},
        {"label":"Thorax RIP","type":"effort","profile":"thorax","amplitude":0.82,"frequency":0.24,"phase":0.18,"features":[{"type":"effort-ramp","start":7.5,"end":17.5,"gain":0.70}]},

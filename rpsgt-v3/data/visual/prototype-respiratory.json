{
  "meta": {
    "name": "RPSGT Respiratory Visual Pack 1",
    "version": 1,
    "labId": "visual-respiratory",
    "developmentOnly": true,
    "appAuthored": true,
    "sourceType": "app-authored-schematic",
    "sourceBasis": "Respiratory signal relationships are paraphrased from project sleep-technology references. No source figure, patient tracing, proprietary scoring-manual figure, or rule table is reproduced.",
    "clinicalBoundary": "Pattern-recognition practice only. Event morphology does not establish that current clinical scoring criteria are met. Use current official scoring guidance, facility policy, equipment instructions, and supervised competency for clinical decisions."
  },
  "studies": [
    {
      "id": "resp-normal-001",
      "title": "Schematic normal breathing segment",
      "pattern": "Normal breathing",
      "durationSeconds": 30,
      "sampleRate": 50,
      "channels": [
        {"label":"C3-M2","type":"eeg","amplitude":0.48,"phase":0.2},
        {"label":"Nasal Pressure","type":"airflow","profile":"nasal","amplitude":0.88,"frequency":0.24,"phase":0.1},
        {"label":"Thermal Airflow","type":"airflow","profile":"thermal","amplitude":0.72,"frequency":0.24,"phase":0.08},
        {"label":"Thorax RIP","type":"effort","profile":"thorax","amplitude":0.78,"frequency":0.24,"phase":0.18},
        {"label":"Abdomen RIP","type":"effort","profile":"abdomen","amplitude":0.80,"frequency":0.24,"phase":0.24},
        {"label":"RIP Sum","type":"effort","profile":"sum","amplitude":0.82,"frequency":0.24,"phase":0.21},
        {"label":"Snore","type":"snore","amplitude":0.10,"phase":0.4},
        {"label":"SpO2","type":"spo2","amplitude":0.80,"phase":0.3},
        {"label":"ETCO2","type":"co2","amplitude":0.78,"frequency":0.24,"phase":0.1},
        {"label":"ECG","type":"ecg","amplitude":0.82,"heartRate":68,"phase":0.2}
      ]
    },
    {

    {"id":"visual-feature-n2-spindle","studyId":"schematic-n2-001","type":"point-click","taskCode":"D3A","prompt":"Click the sleep-spindle teaching burst in C3-M2.","target":{"channel":"C3-M2","start":13.35,"end":15.05},"toleranceSeconds":0.15,"fallbackPoints":[{"label":"C3-M2 near 4 s","channel":"C3-M2","time":4.0},{"label":"C3-M2 near 8.8 s","channel":"C3-M2","time":8.8},{"label":"C3-M2 near 14.2 s","channel":"C3-M2","time":14.2},{"label":"C3-M2 near 24 s","channel":"C3-M2","time":24.0}],"rationale":"The schematic spindle burst occupies approximately 13.4–15.0 seconds in C3-M2."},
